{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Browser runtime: DOM + async iteration over NodeList/FileList.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // The automatic runtime — no `import React` needed in every .tsx file.
    "jsx": "react-jsx"
  }
}
